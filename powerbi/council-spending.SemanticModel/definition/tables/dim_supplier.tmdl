table dim_supplier

	column supplier_key
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: supplier_key

	column supplier_entity_key
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: supplier_entity_key

	column supplier_name
		dataType: string
		summarizeBy: none
		sourceColumn: supplier_name

	column is_redacted
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: is_redacted

	column supplier_type
		dataType: string
		summarizeBy: none
		sourceColumn: supplier_type

	column name_variants
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: name_variants

	column supplier_id_count
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: supplier_id_count

	column supplier_ids
		dataType: string
		summarizeBy: none
		sourceColumn: supplier_ids

	column first_payment_date
		dataType: dateTime
		formatString: dd mmm yyyy
		summarizeBy: none
		sourceColumn: first_payment_date

	column last_payment_date
		dataType: dateTime
		formatString: dd mmm yyyy
		summarizeBy: none
		sourceColumn: last_payment_date

	column supplier_display
		dataType: string
		summarizeBy: none
		sourceColumn: supplier_display

	column is_named_supplier
		dataType: string
		summarizeBy: none
		sourceColumn: is_named_supplier

	partition dim_supplier = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "dim_supplier.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"supplier_key", Int64.Type}, {"supplier_entity_key", type text}, {"supplier_name", type text}, {"is_redacted", Int64.Type}, {"supplier_type", type text}, {"name_variants", Int64.Type}, {"supplier_id_count", Int64.Type}, {"supplier_ids", type text}, {"first_payment_date", type date}, {"last_payment_date", type date}}, "en-GB"),
					Display = Table.AddColumn(Typed, "supplier_display", each if [is_redacted] = 1 then "Redacted personal data" else fnTidyName([supplier_name]), type text),
					Named = Table.AddColumn(Display, "is_named_supplier", each if [is_redacted] = 1 then "No" else "Yes", type text)
				in
					Named
