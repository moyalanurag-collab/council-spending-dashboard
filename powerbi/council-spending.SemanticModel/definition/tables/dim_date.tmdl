table dim_date
	dataCategory: Time

	column date_key
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: date_key

	column date
		dataType: dateTime
		formatString: dd mmm yyyy
		isKey
		summarizeBy: none
		sourceColumn: date

	column calendar_year
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: calendar_year

	column month_number
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: month_number

	column month_name
		dataType: string
		summarizeBy: none
		sourceColumn: month_name
		sortByColumn: month_number

	column year_month
		dataType: string
		summarizeBy: none
		sourceColumn: year_month

	column financial_year
		dataType: string
		summarizeBy: none
		sourceColumn: financial_year

	column financial_month_number
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: financial_month_number

	column financial_quarter
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: financial_quarter

	column day_of_week
		dataType: string
		summarizeBy: none
		sourceColumn: day_of_week

	column is_weekend
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: is_weekend

	partition dim_date = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "dim_date.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"date_key", Int64.Type}, {"date", type date}, {"calendar_year", Int64.Type}, {"month_number", Int64.Type}, {"month_name", type text}, {"year_month", type text}, {"financial_year", type text}, {"financial_month_number", Int64.Type}, {"financial_quarter", Int64.Type}, {"day_of_week", type text}, {"is_weekend", Int64.Type}}, "en-GB")
				in
					Typed
