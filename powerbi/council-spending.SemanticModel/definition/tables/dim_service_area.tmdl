table dim_service_area

	column service_area_key
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: service_area_key

	column service_area
		dataType: string
		summarizeBy: none
		sourceColumn: service_area

	partition dim_service_area = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "dim_service_area.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"service_area_key", Int64.Type}, {"service_area", type text}}, "en-GB")
				in
					Typed
