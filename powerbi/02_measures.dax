// =====================================================================================
// 02_measures.dax  -  AUTO-GENERATED by powerbi/build_project.py (do not edit by hand).
// These measures are already inside council-spending.pbip; this file is for reading / manual builds.
// They live on the hidden helper table _Measures.
// =====================================================================================

// ---------- Core ----------
Net Spend =
    SUM ( fact_payments[amount] )

Gross Spend =
    CALCULATE ( [Net Spend], fact_payments[amount] > 0 )

Credit Notes =
    CALCULATE ( [Net Spend], fact_payments[amount] < 0 )

Payment Lines =
    COUNTROWS ( fact_payments )

Average Payment =
    DIVIDE ( [Net Spend], [Payment Lines] )

Net Spend (Named Suppliers) =
    CALCULATE ( [Net Spend], dim_supplier[is_redacted] = 0 )

Named Suppliers =
    CALCULATE ( DISTINCTCOUNT ( fact_payments[supplier_key] ), dim_supplier[is_redacted] = 0 )

Redacted Share % =
    DIVIDE ( CALCULATE ( [Net Spend], dim_supplier[is_redacted] = 1 ), [Net Spend] )


// ---------- Time ----------
Net Spend PM =
    CALCULATE ( [Net Spend], DATEADD ( dim_date[date], -1, MONTH ) )

MoM Change =
    [Net Spend] - [Net Spend PM]

MoM Change % =
    DIVIDE ( [MoM Change], [Net Spend PM] )

Net Spend FYTD =
    VAR _fy = MAX ( dim_date[financial_year] ) VAR _max = MAX ( dim_date[date] ) RETURN CALCULATE ( [Net Spend], FILTER ( ALL ( dim_date ), dim_date[financial_year] = _fy && dim_date[date] <= _max ) )

Rolling 3M Net Spend =
    CALCULATE ( [Net Spend], DATESINPERIOD ( dim_date[date], MAX ( dim_date[date] ), -3, MONTH ) )


// ---------- Suppliers ----------
Supplier Rank =
    IF ( HASONEVALUE ( dim_supplier[supplier_display] ), RANKX ( ALLSELECTED ( dim_supplier[supplier_display], dim_supplier[supplier_type] ), [Net Spend (Named Suppliers)], , DESC, DENSE ) )

Share of Total % =
    DIVIDE ( [Net Spend (Named Suppliers)], CALCULATE ( [Net Spend (Named Suppliers)], ALLSELECTED ( dim_supplier ) ) )

Cumulative Share % =
    VAR _cur = [Net Spend (Named Suppliers)] VAR _all = ALLSELECTED ( dim_supplier[supplier_display] ) VAR _total = SUMX ( _all, [Net Spend (Named Suppliers)] ) RETURN DIVIDE ( SUMX ( FILTER ( _all, [Net Spend (Named Suppliers)] >= _cur ), [Net Spend (Named Suppliers)] ), _total )

Top 10 Suppliers Share % =
    VAR _top10 = TOPN ( 10, ALLSELECTED ( dim_supplier[supplier_display] ), [Net Spend (Named Suppliers)], DESC ) RETURN DIVIDE ( SUMX ( _top10, [Net Spend (Named Suppliers)] ), CALCULATE ( [Net Spend (Named Suppliers)], ALLSELECTED ( dim_supplier ) ) )

Net Spend (Top 15 Suppliers) =
    IF ( [Supplier Rank] <= 15, [Net Spend (Named Suppliers)] )

Cumulative Share % (Top 15) =
    IF ( [Supplier Rank] <= 15, [Cumulative Share %] )

Named Payment Lines =
    CALCULATE ( COUNTROWS ( fact_payments ), dim_supplier[is_redacted] = 0 )

New Suppliers =
    CALCULATE ( DISTINCTCOUNT ( dim_supplier[supplier_key] ), USERELATIONSHIP ( dim_supplier[first_payment_date], dim_date[date] ), dim_supplier[is_redacted] = 0 )

One-Month Suppliers =
    VAR _s = ADDCOLUMNS ( CALCULATETABLE ( VALUES ( dim_supplier[supplier_key] ), dim_supplier[is_redacted] = 0 ), "@months", CALCULATE ( COUNTROWS ( SUMMARIZE ( fact_payments, dim_date[year_month] ) ) ) ) RETURN COUNTROWS ( FILTER ( _s, [@months] = 1 ) ) + 0


// ---------- Data quality ----------
DQ Checks Passed =
    COUNTROWS ( FILTER ( dq_results, dq_results[result] = "PASS" ) ) + 0

DQ Checks Warning =
    COUNTROWS ( FILTER ( dq_results, dq_results[result] = "WARN" ) ) + 0

DQ Checks Failed =
    COUNTROWS ( FILTER ( dq_results, dq_results[result] = "FAIL" ) ) + 0

DQ Pass Rate % =
    DIVIDE ( [DQ Checks Passed], [DQ Checks Passed] + [DQ Checks Warning] + [DQ Checks Failed] )

Rows Excluded =
    COUNTROWS ( excluded_rows )

Possible Duplicate Payment Value =
    CALCULATE ( [Net Spend], fact_payments[is_possible_duplicate_payment] = 1 )

Credit Note Count =
    CALCULATE ( [Payment Lines], fact_payments[is_credit_note] = 1 )

DQ Share Affected =
    DIVIDE ( SUM ( dq_results[pct_affected] ), 100 )

Reconciliation Status =
    VAR _fail = [DQ Checks Failed] RETURN IF ( _fail = 0, "Reconciled", _fail & " failed" )


// ---------- Classification ----------
ML Lines =
    COUNTROWS ( ml_predictions )

Model Theme Agreement % =
    AVERAGE ( ml_predictions[theme_agrees] )

Model Category Agreement % =
    AVERAGE ( ml_predictions[category_agrees] )

Lines For Coding Review =
    SUM ( ml_predictions[review_flag] )

Value For Coding Review =
    CALCULATE ( [Net Spend], ml_predictions[review_flag] = 1 )
